# Copy to terraform.tfvars (or pass via CI). Do NOT commit real values.

aws_region  = "us-east-1"
environment = "develop"

# Optional: guard the provider against deploying to the wrong account.
# Empty = no restriction (local validation). CI sets this from AWS_ACCOUNT_ID_<ENV>.
# aws_account_id = "123456789012"

# Backend app (the OS Management API on Kubernetes)
origin_url = "https://app.example.com"

# The auth Lambdas are addressed by deterministic name, not by reading the
# os-management-lambda Terraform state, so the two stacks deploy in any order.
# This must match that repo's `name_prefix` (default "os-auth"); the gateway
# derives <prefix>-issuer-<environment> and <prefix>-authorizer-<environment>.
# lambda_name_prefix = "os-auth"

# Overrides, only if the functions are named differently. Empty = derive.
# issuer_function_name     = ""
# authorizer_function_name = ""
# issuer_invoke_arn        = ""
# authorizer_invoke_arn    = ""

# Structured (JSON) access logs go to CloudWatch. Set to false only if another stack
# already manages the account-level API Gateway CloudWatch Logs role.
# manage_apigw_account = true
# log_retention_days   = 14
